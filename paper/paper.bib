	keywords = {Earth Observations},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/WUM9G7IW/Joyce et al. - 2022 - Discovering Inclusivity in Remote Sensing Leaving.pdf:application/pdf},
}

