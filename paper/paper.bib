	shortjournal = {Sci Data},
	author = {Li, Xiaosong and Shen, Tong and Garcia, Cesar Luis and Teich, Ingrid and Chen, Yang and Chen, Jin and Kabo-Bah, Amos Tiereyangn and Yang, Ziyu and Jia, Xiaoxia and Lu, Qi and Nyamtseren, Mandakh},
	urldate = {2025-04-12},
