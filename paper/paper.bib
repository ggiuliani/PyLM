@article{jones_multi-source_2019,
	title = {Multi-source Dynamic Surface Water Extent ({DSWE}) Model Development},
	volume = {2019},
	url = {https://ui.adsabs.harvard.edu/abs/2019AGUFM.H23O2117J},
	abstract = {The United States Geological Survey ({USGS}) now operationally generates Dynamic Surface Water Extent ({DSWE}) output as a Level-3 Landsat Science Product for the conterminous United States ({CONUS}), Alaska, and Hawaii. The 'partial surface water' or 'wetland' tests within the {DSWE} Model target sub-pixel scale inundation, that is, the presence of surface water in combination with vegetation and/or soil below individual pixel resolution. This affords monitoring of wetland inundation in addition to changes in the extent of open surface water that are detectable by other surface water extent products. The Landsat {DSWE} Model is applied to every clear Landsat Level-2 pixel in the Landsat Archive and every newly collected Landsat scene over the {US} that meets quality standards for inclusion in Analysis Ready Data ({ARD}) format. The results of the processing are openly available through {USGS} Earth Explorer. The Landsat {DSWE} Model is being used for river discharge estimation, lake/reservoir storage change detection, and wetland hydroperiod/health characterization for locations around the Globe. The relative simplicity, ease of implementation, and efficiency of the {DSWE} Model helps make widespread usage possible as no scene-based training data or interpretations are needed to implement the Landsat {DSWE} Model. An expansion of the {DSWE} Model to multiple satellites is underway to increase the temporal and spatial resolutions and facilitate global scale remote sensing of surface water. However, if the {DSWE} Model is to be most accurately employed using sensors other than Landsat, sensor-specific thresholds are required for the {DSWE} partial surface water tests. This makes sensor-specific spectral mixture analyses of the sort used to create Landsat {DSWE} necessary for {DSWE} Model expansion. Specifically, {DSWE} partial surface water tests are being formulated for {MODIS}, Sentinel-2, and Worldview. Multi-sensor {DSWE} Model development progress is evaluated through the application of these formulations, in combination with those from Landsat-based {DSWE}.},
	pages = {H23O--2117},
	author = {Jones, J. W.},
	urldate = {2022-01-26},
	date = {2019-12-01},
	note = {Conference Name: {AGU} Fall Meeting Abstracts
{ADS} Bibcode: 2019AGUFM.H23O2117J},
	keywords = {Water/Hydrology/Oceans, Earth Observations},
}

