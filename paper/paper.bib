@misc{camara_bayesian_2024,
	location = {Rochester, {NY}},
	title = {Bayesian Inference for Post-Processing of Remote Sensing Image Classification},
	url = {https://papers.ssrn.com/abstract=4943043},
	doi = {10.2139/ssrn.4943043},
	abstract = {A key component of remote sensing image analysis is image classification, which aims to categorise the pixels in an image into different classes using machine learning methods. The result of machine learning classifiers is a set of class probabilities for each pixel. These class probabilities are the input to post-processing techniques that aim to improve machine learning results. This paper introduces a new post-processing algorithm that uses an Empirical Bayes approach. We use non-isotropic neighbourhood definitions to simulate the impact of discontinuity between land classes. Our method allows the inclusion of expert knowledge to enhance the consistency of the resulting map. The technique has been validated for large-scale data analysis in connection with a time-first, space-based approach and is available as open-source as part of the R package sits.},
	number = {4943043},
	author = {Camara, Gilberto and Assuncao, Renato and Carvalho, Alexandre and Simões, Rolf and Souza, Felipe Carvalho and Carlos, Felipe Menino},
	urldate = {2024-09-04},
