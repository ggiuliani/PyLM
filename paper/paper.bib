	keywords = {Earth Observations},
	file = {ScienceDirect Full Text PDF:/Users/gregorygiuliani/Zotero/storage/8SFZJT3A/Lary et al. - 2016 - Machine learning in geosciences and remote sensing.pdf:application/pdf},
}

