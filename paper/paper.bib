	doi = {10.1016/j.ecolecon.2016.07.009},
	abstract = {The {UN} Sustainable Development Goals ({SDGs}) offer a detailed dashboard of goals, targets and indicators. In this paper we investigate alternative methods to relate the {SDGs} to overall measures of sustainable wellbeing that can motivate and guide the process of global societal change. We describe what a Sustainable Wellbeing Index ({SWI}) that connects with and complements the {SDG} dashboard might look like. We first investigate several options for how to construct such an index and then discuss what is needed to build consensus around it. Finally, we propose linking the {SDGs} and our {SWI} with a comprehensive systems dynamics model that can track stocks and flows and make projections into the future under different policy scenarios.},
	pages = {350--355},
