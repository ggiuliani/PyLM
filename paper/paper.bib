	keywords = {{GEO}/{GEOSS}},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/NZAHGFWG/Craglia et al. - 2017 - Exploring the depths of the global earth observati.pdf:application/pdf},
}

