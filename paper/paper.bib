	title = {A grid-enabled web map server},
	url = {://000229276500051},
	shorttitle = {A grid-enabled web map server},
	abstract = {Today Geographic Information Systems ({GIS}) provide several tools for studying and analyzing varied human and natural phenomena, therefore {GIS} and geospatial data has grown so much in both public and private organizations. A Challenge is the integration of these data to get innovative and exhaustive knowledge about topics of interest.
