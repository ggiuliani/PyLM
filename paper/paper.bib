	eprinttype = {arxiv},
	eprint = {2305.08413 [cs, eess, stat]},
	keywords = {Big Data, Earth Observations, Data Cube, Land Cover/Land Use, {AI}},
	file = {Tuia et al. - 2023 - Artificial intelligence to advance Earth observati.pdf:/Users/gregorygiuliani/Zotero/storage/FEKJMBJW/Tuia et al. - 2023 - Artificial intelligence to advance Earth observati.pdf:application/pdf},
