	langid = {english},
	doi = {10.1007/978-3-319-65633-5_15},
	keywords = {Big Data},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/AC6U4F5D/Monroe et al. - 2018 - Putting Big Data Innovation into Action for Develo.pdf:application/pdf},
