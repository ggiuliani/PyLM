@article{kumi-boateng_assessing_2010,
	title = {Assessing the Quality of Spatial Data},
	volume = {43},
	issn = {1450-216X},
	url = {http://www.eurojournals.com/ejsr_43_4_07.pdf},
	shorttitle = {Assessing the Quality of Spatial Data},
	abstract = {Data sharing and data integration are inevitable consequence of the widespread availability of Geographic Information System ({GIS}) technologies due to the high initial cost of establishing a spatial database. Because spatial data is transferred and shared by many users, the data must be trustworthy and useful. To ensure that existing digital data is appropriately used, the data producer must provide documentation about the history of spatial data. In addition, data developers and users have begun to document and implement data quality measurements which allow judgment to be made about spatial data. Spatial data is frequently relied upon as factual data and good data quality measures and documentation may eliminate liability law suits against data developers and users. Data creators must be aware of the implications involved with carelessly developing spatial data if that data is intended to be used for lawful reasons. On the other hand, the data user must also be responsible for understanding the limitations of that spatial data. This paper seeks to present a review of the description of spatial data quality, elements of data quality and assesses the future of spatial data quality as well as the role that a proposed Spatial Data Authority in Ghana ({SPADAG}) may play in data sharing and integration.},
	pages = {507--515},
	number = {4},
	journaltitle = {European Journal of Scientific Research},
	author = {Kumi-Boateng, Bernard and Yakubu, Issaka},
	date = {2010},
	keywords = {{SDI}},
	file = {ejsr_43_4_07:/Users/gregorygiuliani/Zotero/storage/8CIKKE6J/ejsr_43_4_07.pdf:application/pdf},
}

