Publisher: Multidisciplinary Digital Publishing Institute},
	keywords = {Earth Observations, Switzerland, Vegetation, Habitat},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/FBRJD7WV/Price et al. - 2023 - The Habitat Map of Switzerland A Remote Sensing, .pdf:application/pdf},
