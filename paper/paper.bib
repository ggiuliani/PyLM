@article{sun_cyberconnector:_2018,
	title = {{CyberConnector}: a service-oriented system for automatically tailoring multisource Earth observation data to feed Earth science models},
	volume = {11},
	issn = {1865-0473, 1865-0481},
	url = {https://link.springer.com/article/10.1007/s12145-017-0308-4},
	doi = {10.1007/s12145-017-0308-4},
	shorttitle = {{CyberConnector}},
	abstract = {Feeding multisource Earth observation ({EO}) data into Earth science models ({ESM}) remains a daunting challenge. This paper presents a service-oriented approach as an alternative solution. It uses geospatial web services to process the {EO} data and geoprocessing workflow for automation. Different from existing approaches, it takes advantage of virtual data products ({VDP}) to release modelers from intensive data processing. It can directly connect {ESMs} to public {EO} sources via Cyberinfrastructure. A prototype called {CyberConnector} is implemented. {CyberConnector} supports intuitive building of {VDP}, automatic execution of workflows and effortless retrieval of model-ready input files. We used it to stream multiple datasets to several {ESMs} including finite-volume coastal ocean model ({FVCOM}) and cloud-resolving model ({CRM}). The results show that {CyberConnector} can truly benefit modelers on time saving and effort minimizing.},
	pages = {1--17},
	number = {1},
	journaltitle = {Earth Science Informatics},
	shortjournal = {Earth Sci Inform},
	author = {Sun, Ziheng and Di, Liping and Hao, Haosheng and Wu, Xiaoqing and Tong, Daniel Q. and Zhang, Chen and Virgei, Cora and Fang, Hui and Yu, Eugene and Tan, Xicheng and Yue, Peng and Lin, Li},
	urldate = {2018-05-08},
