@article{aggestam_setting_2019,
	title = {Setting the stage for a Shared Environmental Information System},
	volume = {92},
	issn = {1462-9011},
	url = {http://www.sciencedirect.com/science/article/pii/S1462901118306944},
	doi = {10.1016/j.envsci.2018.11.008},
	abstract = {There has been a significant increase in efforts to improve environmental data sharing practices in the past decade. One such initiative is the Shared Environmental Information System ({SEIS}), initiated by the European Commission in 2008, as part of a process to facilitate regular environmental assessments and State-of-the-Environment Reporting ({SOER}). Using {SEIS} as a case study example, this paper takes its departure from the 8th Environment for Europe ({EFE}) Ministerial conference to identify ongoing processes and challenges surrounding environmental data and information sharing. The paper relies on data obtained for the 2016 report on progress in establishing {SEIS} in support of regular reporting in the pan-European region. The article demonstrates a number of gaps with regards to the availability and accessibility of certain environmental datasets and indicators and highlights the suboptimal use of information, where comprehensive data flows and high-quality information is not being used adequately in support of policymaking or where there is selective use of environmental indicators. Against this background, questions arise as to whether applied models for data sharing can be implemented with equal success across different regions and countries that are characterized by heterogeneous and complex data practices and data flows. Most importantly, results from the {SEIS} progress report demonstrate the pressing need for a better understanding of environmental data types, data packaging and data flows across multiples contexts, epistemic cultures and policy making.},
	pages = {124--132},
	journaltitle = {Environmental Science \& Policy},
	shortjournal = {Environmental Science \& Policy},
	author = {Aggestam, Filip},
	urldate = {2019-01-14},
	date = {2019-02-01},
	keywords = {{SDI}},
	file = {ScienceDirect Full Text PDF:/Users/gregorygiuliani/Zotero/storage/H8DUC2SZ/Aggestam - 2019 - Setting the stage for a Shared Environmental Infor.pdf:application/pdf},
}

@article{ruetschi_rapid_2019,
	title = {Rapid Detection of Windthrows Using Sentinel-1 C-Band {SAR} Data},
	volume = {11},
	rights = {http://creativecommons.org/licenses/by/3.0/},
	url = {https://www.mdpi.com/2072-4292/11/2/115},
	doi = {10.3390/rs11020115},
	abstract = {Storm events are capable of causing windthrow to large forest areas. A rapid detection of the spatial distribution of the windthrown areas is crucial for forest managers to help them direct their limited resources. Since synthetic aperture radar ({SAR}) data is acquired largely independent of daylight or weather conditions, {SAR} sensors can produce temporally consistent and reliable data with a high revisit rate. In the present study, a straightforward approach was developed that uses Sentinel-1 (S-1) C-band {VV} and {VH} polarisation data for a rapid windthrow detection in mixed temperate forests for two study areas in Switzerland and northern Germany. First, several S-1 acquisitions of approximately 10 before and 30 days after the storm event were radiometrically terrain corrected. Second, based on these S-1 acquisitions, a {SAR} composite image of before and after the storm was generated. Subsequently, after analysing the differences in backscatter between before and after the storm within windthrown and intact forest areas, a change detection method was developed to suggest potential locations of windthrown areas of a minimum extent of 0.5 ha\&mdash;as is required by the forest management. The detection is based on two user-defined parameters. While the results from the independent study area in Germany indicated that the method is very promising for detecting areal windthrow with a producer\&rsquo;s accuracy of 0.88, its performance was less satisfactory at detecting scattered windthrown trees. Moreover, the rate of false positives was low, with a user\&rsquo;s accuracy of 0.85 for (combined) areal and scattered windthrown areas. These results underscore that C-band backscatter data have great potential to rapidly detect the locations of windthrow in mixed temperate forests within a short time (approx. two weeks) after a storm event. Furthermore, the two adjustable parameters allow a flexible application of the method tailored to the user\&rsquo;s needs.},
	pages = {115},
	number = {2},
	journaltitle = {Remote Sensing},
	author = {Rüetschi, Marius and Small, David and Waser, Lars T.},
	urldate = {2019-01-14},
	date = {2019-01},
	langid = {english},
	keywords = {Earth Observations},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/XE8VVMWK/Rüetschi et al. - 2019 - Rapid Detection of Windthrows Using Sentinel-1 C-B.pdf:application/pdf},
}

