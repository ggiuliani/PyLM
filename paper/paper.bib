@article{vihervaara_how_2017,
	title = {How Essential Biodiversity Variables and remote sensing can help national biodiversity monitoring},
	volume = {10},
	issn = {2351-9894},
	url = {http://www.sciencedirect.com/science/article/pii/S2351989416301482},
	doi = {10.1016/j.gecco.2017.01.007},
	abstract = {Essential Biodiversity Variables ({EBVs}) have been suggested to harmonize biodiversity monitoring worldwide. Their aim is to provide a small but comprehensive set of monitoring variables that would give a balanced picture of the development of biodiversity and the reaching of international and national biodiversity targets. Globally, {GEO} {BON} (Group on Earth Observations Biodiversity Observation Network) has suggested 22 candidate {EBVs} to be monitored. In this article we regard {EBVs} as a conceptual tool that may help in making national scale biodiversity monitoring more robust by pointing out where to focus further development resources. We look at one country –Finland –with a relatively advanced biodiversity monitoring scheme and study how well Finland’s current biodiversity state indicators correspond with {EBVs}. In particular, we look at how national biodiversity monitoring could be improved by using available remote sensing ({RS}) applications. Rapidly emerging new technologies from drones to airborne laser scanning and new satellite sensors providing imagery with very high resolution ({VHR}) open a whole new world of opportunities for monitoring the state of biodiversity and ecosystems at low cost. In Finland, several {RS} applications already exist that could be expanded into national indicators. These include the monitoring of shore habitats and water quality parameters, among others. We hope that our analysis and examples help other countries with similar challenges. Along with {RS} opportunities, our analysis revealed also some needs to develop the {EBV} framework itself.},
	pages = {43--59},
	journaltitle = {Global Ecology and Conservation},
	shortjournal = {Global Ecology and Conservation},
	author = {Vihervaara, Petteri and Auvinen, Ari-Pekka and Mononen, Laura and Törmä, Markus and Ahlroth, Petri and Anttila, Saku and Böttcher, Kristin and Forsius, Martin and Heino, Jani and Heliölä, Janne and Koskelainen, Meri and Kuussaari, Mikko and Meissner, Kristian and Ojala, Olli and Tuominen, Seppo and Viitasalo, Markku and Virkkala, Raimo},
	urldate = {2017-02-22},
	date = {2017-04},
	keywords = {Essential Variables},
	file = {ScienceDirect Full Text PDF:/Users/gregorygiuliani/Zotero/storage/I7IKQ2PB/Vihervaara et al. - 2017 - How Essential Biodiversity Variables and remote se.pdf:application/pdf},
}

