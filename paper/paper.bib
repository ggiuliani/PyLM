	langid = {english},
	keywords = {Earth Observations, Digital Twin},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/VJI56GUA/Saltelli et al. - 2025 - Digital Twins of the Earth Between Vision and Fiction.pdf:application/pdf},
}

@article{van_vuuren_exploring_2025,
	title = {Exploring pathways for world development within planetary boundaries},
	volume = {641},
	rights = {2025 The Author(s)},
	issn = {1476-4687},
	url = {https://www.nature.com/articles/s41586-025-08928-w},
	doi = {10.1038/s41586-025-08928-w},
	abstract = {The pressures humanity has been placing on the environment have put Earth’s stability at risk. The planetary boundaries framework serves as a method to define a ‘safe operating space for humanity’1,2 and has so far been applied mostly to highlight the currently prevailing unsustainable environmental conditions. The ability to evaluate trends over time, however, can help us explore the consequences of alternative policy decisions and identify pathways for living within planetary boundaries3. Here we use the Integrated Model to Assess the Global Environment4 to project control variables for eight out of nine planetary boundaries under alternative scenarios to 2050, both with and without strong environmental policy measures. The results show that, with current trends and policies, the situation is projected to worsen to 2050 for all planetary boundaries, except for ozone depletion. Targeted interventions, such as implementing the Paris climate agreement, a shift to a healthier diet, improved food, and water- and nutrient-use efficiency, can effectively reduce the degree of transgression of the planetary boundaries, steering humanity towards a more sustainable trajectory (that is, if they can be implemented based on social and institutional feasibility considerations). However, even in this scenario, several planetary boundaries, including climate change, biogeochemical flows and biodiversity, will remain transgressed in 2050, partly as result of inertia. This means that more-effective policy measures will be needed to ensure we are living well within the planetary boundaries.},
	pages = {910--916},
	number = {8064},
	journaltitle = {Nature},
	author = {van Vuuren, Detlef P. and Doelman, Jonathan C. and Schmidt Tagomori, Isabela and Beusen, Arthur H. W. and Cornell, Sarah E. and Röckstrom, Johan and Schipper, Aafke M. and Stehfest, Elke and Ambrosio, Geanderson and van den Berg, Maarten and Bouwman, Lex and Daioglou, Vassilis and Harmsen, Mathijs and Lucas, Paul and van der Wijst, Kaj-Ivar and van Zeist, Willem-Jan},
	urldate = {2025-05-23},
	date = {2025-05},
	langid = {english},
	note = {Publisher: Nature Publishing Group},
	keywords = {Sustainability/{SDG}/{PB}},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/XLUYBZTR/van Vuuren et al. - 2025 - Exploring pathways for world development within planetary boundaries.pdf:application/pdf},
}

