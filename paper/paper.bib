	keywords = {Light pollution},
	file = {1701528_SM.pdf:/Users/gregorygiuliani/Zotero/storage/LYSC9RUK/1701528_SM.pdf:application/pdf;Full Text PDF:/Users/gregorygiuliani/Zotero/storage/Q22XGQGI/Kyba et al. - 2017 - Artificially lit surface of Earth at night increas.pdf:application/pdf},
