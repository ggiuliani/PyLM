	url = {https://www.int-arch-photogramm-remote-sens-spatial-inf-sci.net/XLVIII-4-W1-2022/59/2022/},
	doi = {10.5194/isprs-archives-XLVIII-4-W1-2022-59-2022},
	abstract = {{\textless}p{\textgreater}{\textless}strong class="journal-{contentHeaderColor}"{\textgreater}Abstract.{\textless}/strong{\textgreater} Interoperability standards from the Open Geospatial Consortium ({OGC}) shape a backbone within the {OSGeo} community by defining a pathway to software implementation toward the standardization of geospatial information and related services ensuring interoperability between {FOSS}4G software. In 2016, the {OGC} has initiated the creation of a new generation of standards based on the {OpenAPI} specifications to facilitate the integration of geospatial data in modern web applications and systems. From a practical perspective this paper intends to address the question how organizations and institutions anticipate to leverage this new generation of standards in order to deploy a geospatial data infrastructure. This issue is at the core of this article and at the center of a project that seeks to address the issue by running a Testbed Platform with a special focus to the Swiss context. To challenge these standards, the Testbed platform is configured to run a showcase with experimental cases about climate change. It is expected to bring good visibility toward all actors concerned by the Swiss standardization process and to raise interest from government stakeholders, technical or not, companies and universities as a community in synergy when considering the advances at the {OGC}.{\textless}/p{\textgreater}},
	eventtitle = {{ISPRS} {WG} {IV}/4, {III}/10, {IV}/7, V/1 \& {ICWG} {IV}/{III}{\textless}br{\textgreater}Free and Open Source Software for Geopsatial ({FOSS}4G) 2022 – Academic Track - 22\&ndash;28 August 2022, Florence, Italy},
	pages = {59--65},
	booktitle = {The International Archives of the Photogrammetry, Remote Sensing and Spatial Information Sciences},
	publisher = {Copernicus {GmbH}},
	author = {Blanc, N. and Cannata, M. and Collombin, M. and Ertz, O. and Giuliani, G. and Ingensand, J.},
	urldate = {2022-08-15},
	date = {2022-08-05},
