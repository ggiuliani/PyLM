@article{engel_ecosystem_nodate,
	title = {Ecosystem services — a useful concept for addressing water challenges?},
	volume = {5},
	issn = {1877-3435},
	url = {http://www.sciencedirect.com/science/article/pii/S1877343513001589},
	doi = {10.1016/j.cosust.2013.11.010},
	shorttitle = {Ecosystem services — a useful concept for addressing water challenges?},
	abstract = {The concept of ecosystem services ({ES}) has gained high popularity as a bridging concept between societal and environmental systems, natural and social sciences. It is subject to considerable debate and controversy. We review whether and how the concept may be useful to address water challenges. We also highlight major controversies and common misunderstandings regarding the {ES} concept. The {ES} concept is not a panacea for solving global water problems, but it may be part of the solution. It can help to identify and negotiate trade-offs between different management options and to develop policies aligning private incentives with societal objectives. Challenges in application include the complexity of water-related {ES}, a lack of truly interdisciplinary studies and of a coherent {ES} framework, and the polarization of arguments.},
	pages = {696--707},
	number = {6},
	journaltitle = {Current Opinion in Environmental Sustainability},
	author = {Engel, Stefanie and Schaefer, Marleen},
	keywords = {Water/Hydrology/Oceans},
	file = {1-s2.0-S1877343513001589-main:/Users/gregorygiuliani/Zotero/storage/XN6FMQDN/1-s2.0-S1877343513001589-main.pdf:application/pdf},
}

