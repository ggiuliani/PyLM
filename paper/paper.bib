	keywords = {Earth Observations},
	file = {Submitted Version:/Users/gregorygiuliani/Zotero/storage/6UHRRN3Q/Small et al. - 2012 - Terrain-flattened gamma nought Radarsat-2 backscat.pdf:application/pdf},
}

@inproceedings{small_sar_2012,
	title = {{SAR} backscatter multitemporal compositing via local resolution weighting},
	doi = {10.1109/IGARSS.2012.6350465},
	abstract = {A method is presented for generating composite {SAR} imagery from a set of multiple radiometrically terrain-corrected ({RTC}) backscatter images and their co-registered local illuminated areas. The process is implemented in map geometry: the resolution of each image is estimated locally as the inverse of the local contributing area and used to weight the contributions from all available observations. Some potential contributors could be out-of-swath or occluded by radar shadow. The resulting composite backscatter image can trade off temporal resolution for improved local spatial resolution while simultaneously increasing the local number of looks. The composite image is characterized by more homogenous properties (resolution, noise) in comparison to single acquisitions. The technique is demonstrated using {ScanSAR} data from {ENVISAT} {ASAR} and Radarsat-2.},
	eventtitle = {2012 {IEEE} International Geoscience and Remote Sensing Symposium},
	pages = {4521--4524},
	booktitle = {2012 {IEEE} International Geoscience and Remote Sensing Symposium},
	author = {Small, D.},
	date = {2012-07},
	keywords = {Earth Observations},
