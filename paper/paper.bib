@article{moilanen_novel_2022,
	title = {Novel methods for spatial prioritization with applications in conservation, land use planning and ecological impact avoidance},
	volume = {13},
	rights = {© 2022 The Authors. Methods in Ecology and Evolution published by John Wiley \& Sons Ltd on behalf of British Ecological Society.},
	issn = {2041-210X},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/2041-210X.13819},
	doi = {10.1111/2041-210X.13819},
	abstract = {Spatial (conservation) prioritization integrates data on the distributions of biodiversity, costs and threats. It produces spatial priority maps that can support ecologically well-informed land use planning in general, including applications in environmental impact avoidance outside protected areas. Here we describe novel methods that significantly increase the utility of spatial priority ranking in large analyses and with interactive planning. Methodologically, we describe a novel algorithm for implementing spatial priority ranking, novel alternatives for balancing between biodiversity features, fast tiled {FFT} transforms for connectivity calculations based on dispersal kernels, and a novel analysis output, the flexibility map. Marking by N the number of landscape elements with data, the new prioritization algorithm has time scaling of less than Nlog2N instead of the N2 of its predecessor. We illustrate feasible computation times with data up to billions of elements in size, implying capacity for global analysis at a resolution higher than 0.25 km2, or close to 1-ha resolution for a continent. The algorithmic improvements described here bring about improved capacity to implement decision support for real-world spatial conservation planning problems. The methods described here will be at the technical core of forthcoming software releases.},
	pages = {1062--1072},
	number = {5},
	journaltitle = {Methods in Ecology and Evolution},
	author = {Moilanen, Atte and Lehtinen, Pauli and Kohonen, Ilmari and Jalkanen, Joel and Virtanen, Elina A. and Kujala, Heini},
	urldate = {2025-02-13},
	date = {2022},
	langid = {english},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1111/2041-210X.13819},
	keywords = {Biodiversity/{ES}/{NatCap}},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/XNXCLBM7/Moilanen et al. - 2022 - Novel methods for spatial prioritization with applications in conservation, land use planning and ec.pdf:application/pdf},
}

@report{lambiel_evolution_2024,
	title = {Evolution et consolidation de l’infrastructure écologique – Analyse comparative des méthodologies d’identification de l’infrastructure écologique sur le canton de Genève},
	url = {https://archive-ouverte.unige.ch/unige:182161},
	abstract = {{\textless}p{\textgreater}Ce document dresse une analyse comparative des méthodes d’identification de l’infrastructure écologique proposées par la Confédération, {InfoSpecies} et {GE}-21. Il examine en détail les aspects techniques et l’application pratique de chaque méthodologie. Une analyse didactique supplémentaire permet d’approfondir la compréhension des différences et des complémentarités qui sont observées entre les méthodes, dans le but de quantifier leur plus-value mais aussi de caractériser la compatibilité des méthodes {InfoSpecies} et {GE}-21 avec celle proposée par la Confédération. Les résultats de cette analyse sont des éléments clés pour le soutien de l’identification de l’infrastructure écologique dans d’autres cantons.{\textless}/p{\textgreater} {\textless}p{\textgreater}Bien que les trois méthodes aboutissent à des résultats globalement convergents, notamment et termes de couverture territoriale, des différences notables apparaissent lorsque les bases conceptuelles sont examinées. La méthode fédérale se distingue par une mise en oeuvre simple et rapide, s’appuyant sur des objets déjà existants (inventaires, réserves naturelles, sites prioritaires, etc.). La méthode {InfoSpecies} propose une approche naturaliste innovante, évaluant les surfaces nécessaires à la protection de la biodiversité et ce à différentes échelles. Enfin, la méthode {GE}-21 se base sur l’intégration de différents piliers, permettant une vision plus intégrée de la conservation de la biodiversité et des activités humaines. Toutes présentes des atouts spécifiques, et une combinaison de ces différentes méthodes pourraient être particulièrement bénéfique. Notre analyse montre que la méthode proposée par {GE}-21 est efficace et permet de faciliter l’intégration de mesure de protection dans les projets d’aménagement. Son approche flexible permet d’identifier un scénario optimal tout en pouvant s’adapter à des contraintes spécifiques, et être appliquée sur d’autres régions ou à d’autres échelles.{\textless}/p{\textgreater}},
	institution = {Université de Genève},
	author = {Lambiel, Audrey and Waller, Noé and Wyler, Nicolas and Lehmann, Anthony},
	urldate = {2025-02-13},
	date = {2024-02-28},
	keywords = {Biodiversity/{ES}/{NatCap}},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/BGS6EAXB/Lambiel et al. - 2024 - Evolution et consolidation de l’infrastructure écologique – Analyse comparative des méthodologies d’.pdf:application/pdf},
}

