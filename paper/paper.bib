	url = {https://www.nature.com/articles/s41597-023-02439-x},
	doi = {10.1038/s41597-023-02439-x},
	abstract = {State-of-the-art methodologies to monitor deforestation rely mostly on optical satellite observations. High-density optical time series can enable the detection of deforestation almost as soon as it occurs. However, deforestation monitoring in the tropics can be hindered by high cloud coverage, and thus the responsiveness of managers, enforcement agencies, and scientists. To understand the implications of cloud contamination in freely available optical data we analyzed combined time series from Landsat 7, 8, and Sentinel-2 over the tropics from 2017–2021. Datasets derived for each 30 m × 30 m of the 59.4 M km2 domain include a) number of cloud-free observations per year, b) maximum consecutive days without clear imagery within a year, and c) final date of the longest waiting period. The datasets reflect where and when data gaps in optical time series exist due to cloud contamination. Scripts to access and extend the datasets are shared and documented. The datasets can be used to prioritize areas where complementary observations, such as radar imagery, are needed for implementing effective deforestation alert systems.},
	pages = {550},
	number = {1},
	journaltitle = {Scientific Data},
