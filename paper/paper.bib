	langid = {english},
	keywords = {Cartography},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/KELA92Z4/Veenendaal et al. - 2017 - Review of Web Mapping Eras, Trends and Directions.pdf:application/pdf},
}

