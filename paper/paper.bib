@article{fienen_social.water_2012,
	title = {Social.Water - A crowdsourcing tool for environmental data acquisition},
	volume = {49},
	issn = {0098-3004},
	url = {http://www.sciencedirect.com/science/article/pii/S0098300412002105},
	doi = {10.1016/j.cageo.2012.06.015},
	shorttitle = {Social.Water‚ÄîA crowdsourcing tool for environmental data acquisition},
	abstract = {Remote telemetry has a long history of use for collection of environmental measurements. With the rise of mobile phones and {SMS} text-messaging capacity, many members of the general pubic carry communications equipment in their pockets at all times. Enabling the general public to provide environmental data through text messages has the potential both to provide additional data to scientific projects and also to raise awareness of the projects through participation. Hydrologic measurements ‚Äì some of which can be made without training, involve a single measurement, and are often made in rural areas ‚Äì are well-suited to text-message conveyance. Many other environmental measurements are similarly well-suited for this technology. Social.Water is a software package, written in Python, that collects, parses, and categorizes text messages sent to a dedicated phone number, updates a simple database, and posts both graphical results and the database on the Web. Social.Water was designed as the backend to the Crowdhydrology project and is written in an object-oriented design that makes customization and modification straightforward.},
	pages = {164--169},
