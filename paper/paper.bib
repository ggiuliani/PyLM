@article{sanchez_de_miguel_colour_2019,
	title = {Colour remote sensing of the impact of artificial light at night (I): The potential of the International Space Station and other {DSLR}-based platforms},
	volume = {224},
	issn = {0034-4257},
	url = {http://www.sciencedirect.com/science/article/pii/S0034425719300410},
	doi = {10.1016/j.rse.2019.01.035},
	shorttitle = {Colour remote sensing of the impact of artificial light at night (I)},
	abstract = {Sensors on remote sensing satellites have provided useful tools for evaluation of the environmental impacts of nighttime artificial light pollution. However, due to their panchromatic nature, the data available from these sensors ({VIIRS}/{DNB} and {DMSP}/{OLS}) has a limited capacity accurately to assess this impact. Moreover, in some cases, recorded variations can be misleading. Until new satellite platforms and sensors are available, only nighttime images taken with {DSLR} cameras from the International Space Station ({ISS}), airplanes, balloons or other such platforms can provide the required information. Here we describe a theoretical approach using colour-colour diagrams to analyse images taken by astronauts on the {ISS} to estimate spatial and temporal variation in the spectrum of artificial lighting emissions. We then evaluate how this information can be used to determine effects on some key environmental indices: photopic vision, the Melatonin Suppression Index, the Star Light Index, the Induced Photosynthesis Index, production of {NO}2-{NO} radicals, energy efficiency and {CO}2 emissions, and Correlated Colour Temperature. Finally, we use the city of Milan as a worked example of the approach.},
	pages = {92--103},
	journaltitle = {Remote Sensing of Environment},
	shortjournal = {Remote Sensing of Environment},
	author = {Sánchez de Miguel, Alejandro and Kyba, Christopher C. M. and Aubé, Martin and Zamorano, Jaime and Cardiel, Nicolas and Tapia, Carlos and Bennie, Jon and Gaston, Kevin J.},
	urldate = {2019-04-23},
	date = {2019-04-01},
	keywords = {Light pollution},
	file = {ScienceDirect Full Text PDF:/Users/gregorygiuliani/Zotero/storage/ANT2G7KL/Sánchez de Miguel et al. - 2019 - Colour remote sensing of the impact of artificial .pdf:application/pdf},
}

