	urldate = {2017-11-14},
	date = {2017-01-02},
	keywords = {Earth Observations},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/CUFWAYVJ/Agapiou - 2017 - Remote sensing heritage in a petabyte-scale satel.pdf:application/pdf},
}

