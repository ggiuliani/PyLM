	shortjournal = {Ieee J-Stars},
	author = {Zhang, B. and Di, L. P. and Yu, G. N. and Han, W. G. and Wang, H. L.},
	date = {2012-12},
	keywords = {Sensors},
	file = {06205339:/Users/gregorygiuliani/Zotero/storage/2CZTBMX6/06205339.pdf:application/pdf},
}

