	langid = {english},
	doi = {10.1007/978-3-319-65633-5_5},
	keywords = {Data Cube},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/62UHERTI/Baumann et al. - 2018 - Fostering Cross-Disciplinary Earth Science Through.pdf:application/pdf},
