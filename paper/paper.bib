@article{borges_landsat_2022,
	title = {Landsat time series reveal forest loss and woody encroachment in the Ngorongoro Conservation Area, Tanzania},
	volume = {8},
	rights = {© 2022 The Authors. Remote Sensing in Ecology and Conservation published by John Wiley \& Sons Ltd on behalf of Zoological Society of London.},
	issn = {2056-3485},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/rse2.277},
	doi = {10.1002/rse2.277},
	abstract = {The Ngorongoro Conservation Area ({NCA}) of Tanzania, is globally significant for biodiversity conservation due to the presence of iconic fauna, and, since 1959 has been managed as a unique multiple land-use areas to mutually benefit wildlife and indigenous residents. Understating vegetation dynamics and ongoing land cover change processes in protected areas is important to protect biodiversity and ensure sustainable development. However, land cover changes in savannahs are especially difficult, as changes are often long-term and subtle. Here, we demonstrate a Landsat-based monitoring strategy incorporating (i) regression-based unmixing for the accurate mapping of the fraction of the different land cover types, and (ii) a combination of linear regression and the {BFAST} trend break analysis technique for mapping and quantifying land cover changes. Using Google Earth Pro and the {EnMap}-Box software, the fractional cover of the main land cover types of the {NCA} were accurately mapped for the first time, namely bareland, bushland, cropland, forest, grassland, montane heath, shrubland, water and woodland. Our results show that the main changes occurring in the {NCA} are the degradation of upland forests into bushland: we exemplify this with a case study in the Lerai Forest; and found declines in grassland and co-incident increases in shrubland in the Serengeti Plains, suggesting woody encroachment. These changes threaten the wellbeing of livestock, the livelihoods of resident pastoralists and of the wildlife dependent on these grazing areas. Some of the land cover changes may be occurring naturally and caused by herbivory, rainfall patterns and vegetation succession, but many are linked to human activity, specifically, management policies, tourism development and the increase in human population and livestock. Our study provides for the first time much needed and highly accurate information on long-term land cover changes in the {NCA} that can support the sustainable management and conservation of this unique {UNESCO} World Heritage Site.},
	pages = {808--826},
	number = {6},
	journaltitle = {Remote Sensing in Ecology and Conservation},
	author = {Borges, Joana and Higginbottom, Thomas P. and Cain, Bradley and Gadiye, Donatus E. and Kisingo, Alex and Jones, Martin and Symeonakis, Elias},
	urldate = {2024-01-18},
	date = {2022},
	langid = {english},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/rse2.277},
	keywords = {Earth Observations, Biodiversity/{ES}/{NatCap}, Land Cover/Land Use, Vegetation},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/RHBWAIYX/Borges et al. - 2022 - Landsat time series reveal forest loss and woody e.pdf:application/pdf},
}

@article{molder_landsat_2022,
	title = {Landsat Data Ecosystem Case Study: Actor Perceptions of the Use and Value of Landsat},
	volume = {9},
	issn = {2296-665X},
	url = {https://www.frontiersin.org/articles/10.3389/fenvs.2021.805174},
	shorttitle = {Landsat Data Ecosystem Case Study},
	abstract = {It is well-known that Earth observation ({EO}) data plays a critical role in scientific understanding about the global environment. There is also growing support for the use of {EO} data to provide context-specific insights, with significant implications for their use in decision support systems. Technological development over recent years, including cloud computing infrastructure, machine learning techniques, and rapid expansion of the velocity, volume, and variety of space-borne data sources, offer huge potential to provide solutions to the myriad environmental problems facing society and the planet. The {USGS}/{NASA} Landsat Program, the longest continuously gathered source of land surface data, has played a central role in our understanding of environmental change, particularly for its contribution of longitudinal products that offer greater context for present research and decision support activities. The challenge facing the Landsat and {EO} data community, however, now lies in moving beyond context-specific knowledge generation to translating such knowledge into tangible value for society. Drawing from an open data ecosystem framework and qualitative social science methods, we map the Landsat data ecosystem ({LDE}) and the relationships linking multiple actors responsible for processing, indexing, analyzing, synthesizing, and translating raw Landsat data into information that is useful, useable, and used by end users in particular social-environmental contexts. Both the role of Big Data and associated technologies are discussed as they relate to the ultimate use of Landsat-derived information products to guide decision-making, and key data ecosystem characteristics that shape the likelihood of these products’ use are highlighted.},
	journaltitle = {Frontiers in Environmental Science},
	author = {Molder, Edmund B. and Schenkein, Sarah F. and {McConnell}, Abby E. and Benedict, Karl K. and Straub, Crista L.},
	urldate = {2024-01-19},
	date = {2022},
	keywords = {Earth Observations},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/Y4RK5RZR/Molder et al. - 2022 - Landsat Data Ecosystem Case Study Actor Perceptio.pdf:application/pdf},
}

@misc{punalekar_hierarchical-modular_2024,
	location = {Rochester, {NY}},
	title = {Hierarchical-Modular Framework for Habitat Mapping Through Systematic and Informed Integration of Remote Sensing Data with Contextual Information},
	url = {https://papers.ssrn.com/abstract=4695952},
	doi = {10.2139/ssrn.4695952},
	abstract = {Accurate and up-to-date habitat maps at the national or regional level play a crucial role in informing conservation and restoration endeavours. Earth Observation ({EO}) datasets offer significant potential for providing detailed land cover information and monitoring change. Whilst direct translation from land cover to habitat categories can be achieved for some classes, contextual information and expert knowledge is required for providing consistent habitat maps at the regional/national scale.  This study introduces a hierarchical-modular framework based on the globally consistent Food and Agriculture Organization Land Cover Classification System that can be used to systematically link land cover classes to habitats, thereby facilitating the production of habitat maps. The application of the framework is showcased in the context of Wales, United Kingdom. Dense time-series data from Sentinel-1 and –2 were utilised to extract environmental descriptors, including through machine learning algorithms. These descriptors were seamlessly integrated into the modular and hierarchical structure of the framework, resulting in the generation of a land cover map, and some habitat classes. To expand habitat descriptions further, contextual information such as peat depth and an existing habitat map for Wales was incorporated through an expert-knowledge-based decision rule system.The accuracy assessment highlights that habitat classes directly derived from Earth Observation ({EO}) datasets, like cultivated/managed and forest types, demonstrate higher mapping accuracies compared to those heavily dependent on non-{EO}-derived contextual information. Dependency on contextual datasets diminished as detailed habitat maps were generalized into broader categories. The assessment also underscores the significance of addressing inconsistencies with field survey data, particularly concerning contextual information and taxonomical systems— a facet seldom discussed in {EO}-based habitat mapping literature.The study proposes that, for enhanced habitat mapping, efforts should focus not only on {EO} data but also on minimizing inconsistencies in contextual datasets. The flexible structure of the hierarchical framework is highlighted, emphasizing its adaptability for future improvements in habitat mapping by incorporating better contextual datasets and more advanced algorithms for {EO}-derived land cover descriptions.},
	number = {4695952},
