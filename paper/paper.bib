@article{mcdonald_web-based_2019,
	title = {A web-based decision support system tools: The Soil and Water Assessment Tool online visualization and analyses ({SWATOnline}) and {NASA} earth observation data downloading and reformatting tool ({NASAaccess})},
	issn = {1364-8152},
