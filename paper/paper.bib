@article{harris_open_2015,
	title = {Open data policies and satellite Earth observation},
	volume = {32},
	issn = {0265-9646},
	url = {http://www.sciencedirect.com/science/article/pii/S0265964615000028},
	doi = {10.1016/j.spacepol.2015.01.001},
	abstract = {From the Heads of State of the G8 nations, the European Union, international organisations, through to national laws and policies, there is a strong momentum for full, free and open access to public sector digital data so that the benefits of public investment in such data can be maximised with as few barriers to use as possible. While open data for society at large is a relatively new phenomenon, the space sector has been accustomed to open data for all of its existence, especially in astronomy and navigation, but also in Earth observation. In the context of the open data debate, the purpose of this paper is to examine 21 policy and legal instruments concerning open data made by a range of organisations that in one way or another relate to Earth observation data and therefore contribute to the critical examination of the effectiveness of the open data movement. Based on these documents, the paper discusses common issues such as changing perspectives on the desirability of open data, commercial use, and licences and exceptions, and concludes that open access to Earth observation data requires more specification in order to clarify the conditions of access and so to realise fully the potential benefits.},
	pages = {44--53},
