	rights = {2024 The Author(s)},
	issn = {2662-4435},
	url = {https://www.nature.com/articles/s43247-024-01542-0},
	doi = {10.1038/s43247-024-01542-0},
	abstract = {The Brazilian Amazon Satellite Monitoring Program ({PRODES} Amazonia) tracks forest loss in the Brazilian Amazon but excludes about 6.6\% ( {\textasciitilde} 280,000 km²) of non-forest vegetation ({NF}). Here we developed the {PRODES} {NF} system to address this gap by adapting the well-established methodology of {PRODES} Amazonia. Initial findings from {PRODES} {NF} show that the Brazilian Amazon lost 10.46\% ( {\textasciitilde} 30,000 km²) of {NF} area, mainly in the last two decades, with the estates of Mato Grosso, Roraima, and Amapá being primary hotspots of losses. Savannas were the most affected (13.3\% of their extent). {NF} loss strongly correlates (r = 0.87; p {\textless} 0.0001) with deforestation, suggesting a continuum of vegetation loss in the biome regardless of the predominant vegetation type. Combining data from {PRODES} Amazonia and {PRODES} {NF} reveals an official estimate of {\textasciitilde}798,000 km² in total primary vegetation loss ( {\textasciitilde} 19\% of the entire biome) in the Brazilian Amazon by 2022.},
	pages = {1--9},
	number = {1},
	journaltitle = {Communications Earth \& Environment},
