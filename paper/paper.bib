	shortjournal = {Environmental Modelling \& Software},
	author = {Saah, David and Johnson, Gary and Ashmall, Billy and Tondapu, Githika and Tenneson, Karis and Patterson, Matt and Poortinga, Ate and Markert, Kel and Quyen, Nguyen Hanh and San Aung, Khun and Schlichting, Lena and Matin, Mir and Uddin, Kabir and Aryal, Raja Ram and Dilger, John and Lee Ellenburg, Water and Flores-Anderson, Africa Ixmucane and Wiell, Daniel and Lindquist, Erik and Goldstein, Joshua and Clinton, Nick and Chishtie, Farrukh},
	urldate = {2022-09-28},
