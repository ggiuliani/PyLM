@article{otero_biodiversity_2020,
	title = {Biodiversity policy beyond economic growth},
	volume = {n/a},
	rights = {© 2020 The Authors. Conservation Letters published by Wiley Periodicals, Inc.},
	issn = {1755-263X},
	url = {https://conbio.onlinelibrary.wiley.com/doi/abs/10.1111/conl.12713},
	doi = {10.1111/conl.12713},
	abstract = {Increasing evidence—synthesized in this paper—shows that economic growth contributes to biodiversity loss via greater resource consumption and higher emissions. Nonetheless, a review of international biodiversity and sustainability policies shows that the majority advocate economic growth. Since improvements in resource use efficiency have so far not allowed for absolute global reductions in resource use and pollution, we question the support for economic growth in these policies, where inadequate attention is paid to the question of how growth can be decoupled from biodiversity loss. Drawing on the literature about alternatives to economic growth, we explore this contradiction and suggest ways forward to halt global biodiversity decline. These include policy proposals to move beyond the growth paradigm while enhancing overall prosperity, which can be implemented by combining top-down and bottom-up governance across scales. Finally, we call the attention of researchers and policy makers to two immediate steps: acknowledge the conflict between economic growth and biodiversity conservation in future policies; and explore socioeconomic trajectories beyond economic growth in the next generation of biodiversity scenarios.},
	pages = {e12713},
	issue = {n/a},
	journaltitle = {Conservation Letters},
	author = {Otero, Iago and Farrell, Katharine N. and Pueyo, Salvador and Kallis, Giorgos and Kehoe, Laura and Haberl, Helmut and Plutzar, Christoph and Hobson, Peter and García‐Márquez, Jaime and Rodríguez‐Labajos, Beatriz and Martin, Jean-Louis and Erb, Karl-Heinz and Schindler, Stefan and Nielsen, Jonas and Skorin, Teuta and Settele, Josef and Essl, Franz and Gómez‐Baggethun, Erik and Brotons, Lluís and Rabitsch, Wolfgang and Schneider, François and Pe'er, Guy},
	urldate = {2020-04-30},
	date = {2020},
	langid = {english},
	note = {\_eprint: https://conbio.onlinelibrary.wiley.com/doi/pdf/10.1111/conl.12713},
	keywords = {Sustainability/{SDG}/{PB}, Biodiversity/{ES}/{NatCap}},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/4G6YG9VH/Otero et al. - Biodiversity policy beyond economic growth.pdf:application/pdf},
}

@article{white_quantifying_2020,
	title = {Quantifying large-scale ecosystem stability with remote sensing data},
	volume = {n/a},
	rights = {© 2020 The Authors. Remote Sensing in Ecology and Conservation published by John Wiley \& Sons Ltd on behalf of Zoological Society of London.},
	issn = {2056-3485},
	url = {https://zslpublications.onlinelibrary.wiley.com/doi/abs/10.1002/rse2.148},
	doi = {10.1002/rse2.148},
	abstract = {To fully understand ecosystem functioning under global change, we need to be able to measure the stability of ecosystem functioning at multiple spatial scales. Although a number of stability components have been established at small spatial scales, there has been little progress in scaling these measures up to the landscape. Remote sensing data holds huge potential for studying processes at landscape scales but requires quantitative measures that are comparable from experimental field data to satellite remote sensing. Here we present a methodology to extract four components of ecosystem functioning stability from satellite-derived time series of Enhanced Vegetation Index ({EVI}) data. The four stability components are as follows: variability, resistance, recovery time and recovery rate in ecosystem functioning. We apply our method to the island of Ireland to demonstrate the use of remotely sensed data to identify large disturbance events in productivity. Our method uses stability measures that have been established at the field-plot scale to quantify the stability of ecosystem functioning. This makes our method consistent with previous small-scale stability research, whilst dealing with the unique challenges of using remotely sensed data including noise. We encourage the use of remotely-sensed data in assessing the stability of ecosystems at a scale that is relevant to conservation and management practices.},
	issue = {n/a},
	journaltitle = {Remote Sensing in Ecology and Conservation},
	author = {White, Hannah J. and Gaul, Willson and Sadykova, Dinara and León‐Sánchez, Lupe and Caplat, Paul and Emmerson, Mark C. and Yearsley, Jon M.},
	urldate = {2020-05-02},
	date = {2020},
	langid = {english},
	note = {\_eprint: https://zslpublications.onlinelibrary.wiley.com/doi/pdf/10.1002/rse2.148},
	keywords = {Earth Observations, Biodiversity/{ES}/{NatCap}},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/NUNSFWSW/White et al. - Quantifying large-scale ecosystem stability with r.pdf:application/pdf},
}

@article{tziolas_integrated_2020,
	title = {An integrated methodology using open soil spectral libraries and Earth Observation data for soil organic carbon estimations in support of soil-related {SDGs}},
	issn = {0034-4257},
	url = {http://www.sciencedirect.com/science/article/pii/S0034425720301632},
	doi = {10.1016/j.rse.2020.111793},
	abstract = {There is a growing realization amongst policy-makers that reliable and accurate soil monitoring information is required at scales ranging from regional to global to support ecosystem functions and services in a sustainable manner under the amplifying climate change enabling countries in target setting of the Sustainable Development Goals ({SDGs}). In this line, the need of access to and integration of existing regional in situ Earth Observation ({EO}) data and different sources such as contemporary and forthcoming satellite imagery is highlighted. The current study puts major emphasis on leveraging existing open soil spectral libraries and {EO} systems and bridging them with memory-based learning algorithms that create more cost-efficient and targeted large scale mapping of soil properties. Relying mostly on contemporary capacities and open resources it can be readily applied to countries with differing capacities and levels of development. To test our methodology, the {GEOCRADLE} {SSL} developed in the Balkans, Middle East, and North Africa region and a hyperspectral airborne image were utilized to provide Soil Organic Carbon ({SOC}) maps of cropland fields over an agricultural region near the city of Netanya, Israel. Furthermore, simulated data of forthcoming space-borne satellite ({EnMAP}) and current super-spectral mission (Sentinel 2) were explored. The {SOC} content of the collected in situ soil samples was predicted using a novel local regression approach that combines spatial proximity and spectral similarities. These predictions were subsequently used to develop models using the airborne and simulated satellite spectra, achieving a fair prediction accuracy of R2 {\textgreater} 0.8 and {RPIQ}{\textgreater}2.},
	pages = {111793},
	journaltitle = {Remote Sensing of Environment},
	shortjournal = {Remote Sensing of Environment},
	author = {Tziolas, Nikolaos and Tsakiridis, Nikolaos and Ogen, Yaron and Kalopesa, Eleni and Ben-Dor, Eyal and Theocharis, John and Zalidis, George},
	urldate = {2020-05-03},
	date = {2020-04-29},
	langid = {english},
	keywords = {Earth Observations, Land Degradation},
	file = {ScienceDirect Full Text PDF:/Users/gregorygiuliani/Zotero/storage/5HECW2WS/Tziolas et al. - 2020 - An integrated methodology using open soil spectral.pdf:application/pdf},
}

