Publisher: Multidisciplinary Digital Publishing Institute},
	keywords = {Earth Observations, Land Cover/Land Use},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/9YFGK43G/Bayle et al. - 2019 - Improved Mapping of Mountain Shrublands Using the .pdf:application/pdf},
