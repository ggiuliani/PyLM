	keywords = {{GG} publications},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/VQUBZRDU/Zabala et al. - 2021 - Geospatial User Feedback How to Raise Users’ Voic.pdf:application/pdf},
}

@article{xie_spring_nodate,
	title = {Spring temperature and snow cover climatology drive the advanced springtime phenology (1991–2014) in the European Alps},
