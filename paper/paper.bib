}

@inproceedings{gyulgyulyan_data_2018,
	title = {Data Quality Impact in Business Inteligence},
	doi = {10.1109/IVMEM.2018.00016},
	abstract = {In today's digital world enormous amount of data is collected, categorized, stored for further analysis. The high volume of data is challenging for companies to deal with when the quality of data is in a low level of adequacy. Besides, Data Quality ({DQ}) solutions getting more time-consuming which is a challenge in the case of high volume of data and can cost losses within a company. The {DQ} has a massive impact on Data Exploration Quality ({DEQ}) in decisional process. The article aims to describe a model allowing users to deal with data quality and make decisions considering the quality of the data. Depending on the operational context a user can choose to improve the particular aspect of {DQ} or not, thus by eliminating the need to fully integrate poor data so that not to frustrate the decisions that are made based on that data.},
	eventtitle = {2018 Ivannikov Memorial Workshop ({IVMEM})},
	pages = {47--51},
