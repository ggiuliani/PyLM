	keywords = {Essential Variables, Biodiversity/{ES}/{NatCap}},
	file = {ScienceDirect Full Text PDF:/Users/gregorygiuliani/Zotero/storage/3I5WW96T/O'Connor et al. - 2020 - Monitoring global changes in biodiversity and clim.pdf:application/pdf},
}

