@article{lucas_living_nodate,
	title = {{LIVING} {EARTH}: A {NOVEL} {GLOBALLY} {APPLICABLE} {APPROACH} {TO} {LAND} {MONITORING}},
	abstract = {Living Earth provides a generic framework and capacity for characterising, mapping and monitoring landscapes across multiple spatial scales and temporal frequencies from Earth observation data. The approach has been demonstrated at national levels in Wales and Australia using globally applicable land cover and change taxonomies. Living Earth also has significant potential to plan and realise future landscapes from local to global levels (supporting, for example, restoration of ecosystems and sustainable management of resources) such that both people and nature can benefit in the short to long term.},
