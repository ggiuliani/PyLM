Publisher: Multidisciplinary Digital Publishing Institute},
	keywords = {Earth Observations, Switzerland, Vegetation},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/XENQ7QMS/Koch et al. - 2025 - Assessing Intraspecific Variation of Tree Species Based on Sentinel-2 Vegetation Indices Across Spac.pdf:application/pdf},
