Publisher: Nature Publishing Group},
	keywords = {Earth Observations, Vegetation},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/FJ6HWRT6/Flores-Anderson et al. - 2023 - Spatial and Temporal Availability of Cloud-free Op.pdf:application/pdf},
