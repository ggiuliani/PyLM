}

@article{hummel_ecosystem_2017,
	title = {Ecosystem services in European protected areas: Ambiguity in the views of scientists and managers?},
	volume = {12},
	issn = {1932-6203},
	url = {http://journals.plos.org/plosone/article?id=10.1371/journal.pone.0187143},
	doi = {10.1371/journal.pone.0187143},
	shorttitle = {Ecosystem services in European protected areas},
	abstract = {Protected Areas are a key component of nature conservation. They can play an important role in counterbalancing the impacts of ecosystem degradation. For an optimal protection of a Protected Area it is essential to account for the variables underlying the major Ecosystem Services an area delivers, and the threats upon them. Here we show that the perception of these important variables differs markedly between scientists and managers of Protected Areas in mountains and transitional waters. Scientists emphasise variables of abiotic and biotic nature, whereas managers highlight socio-economic, cultural and anthropogenic variables. This indicates fundamental differences in perception. To be able to better protect an area it would be advisable to bring the perception of scientists and managers closer together. Intensified and harmonised communication across disciplinary and professional boundaries will be needed to implement and improve Ecosystem Service oriented management strategies in current and future Protected Areas.},
	pages = {e0187143},
	number = {11},
	journaltitle = {{PLOS} {ONE}},
	shortjournal = {{PLOS} {ONE}},
	author = {Hummel, Christiaan and Provenzale, Antonello and Meer, Jaap van der and Wijnhoven, Sander and Nolte, Arno and Poursanidis, Dimitris and Janss, Guyonne and Jurek, Matthias and Andresen, Magnus and Poulin, Brigitte and Kobler, Johannes and Beierkuhnlein, Carl and Honrado, João and Razinkovas, Arturas and Stritih, Ana and Bargmann, Tessa and Ziemba, Alex and Bonet-García, Francisco and Adamescu, Mihai Cristian and Janssen, Gerard and Hummel, Herman},
	urldate = {2018-03-13},
	date = {2017-11-15},
	langid = {english},
	keywords = {Biodiversity/{ES}/{NatCap}},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/5LYTQF7G/Hummel et al. - 2017 - Ecosystem services in European protected areas Am.pdf:application/pdf},
}

@article{eken_key_2004,
	title = {Key Biodiversity Areas as Site Conservation Targets},
	volume = {54},
	issn = {0006-3568},
	url = {https://academic.oup.com/bioscience/article/54/12/1110/329687},
	doi = {10.1641/0006-3568(2004)054[1110:KBAASC]2.0.CO;2},
	abstract = {Site conservation is among the most effective means to reduce global biodiversity loss. Therefore, it is critical to identify those sites where unique biodiversity must be conserved immediately. To this end, the concept of key biodiversity areas ({KBAs}) has been developed, seeking to identify and, ultimately, ensure that networks of globally important sites are safeguarded. This methodology builds up from the identification of species conservation targets (through the {IUCN} Red List) and nests within larger-scale conservation approaches. Sites are selected using standardized, globally applicable, threshold-based criteria, driven by the distribution and population of species that require site-level conservation. The criteria address the two key issues for setting site conservation priorities: vulnerability and irreplaceability. We also propose quantitative thresholds for the identification of {KBAs} meeting each criterion, based on a review of existing approaches and ecological theory to date. However, these thresholds require extensive testing, especially in aquatic systems.},
	pages = {1110--1118},
	number = {12},
	journaltitle = {{BioScience}},
	shortjournal = {{BioScience}},
	author = {Eken, Güven and Bennun, Leon and Brooks, Thomas M. and Darwall, Will and Fishpool, Lincoln D. C. and Foster, Matt and Knox, David and Langhammer, Penny and Matiku, Paul and Radford, Elizabeth and Salaman, Paul and Sechrest, Wes and Smith, Michael L. and Spector, Sacha and Tordoff, Andrew},
	urldate = {2018-03-13},
	date = {2004-12-01},
	langid = {english},
	keywords = {Biodiversity/{ES}/{NatCap}},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/E3QC2GDP/Eken et al. - 2004 - Key Biodiversity Areas as Site Conservation Target.pdf:application/pdf},
}

@article{edgar_key_2008,
	title = {Key biodiversity areas as globally significant target sites for the conservation of marine biological diversity},
	volume = {18},
	issn = {1099-0755},
	url = {http://onlinelibrary.wiley.com/doi/10.1002/aqc.902/abstract},
	doi = {10.1002/aqc.902},
	abstract = {* 1.Recent approaches to the planning of marine protected area ({MPA}) networks for biodiversity conservation often stress the need for a representative coverage of habitat types while aiming to minimize impacts on resource users. As typified by planning for the Australian South-east Marine Region, this strategy can be manipulated by political processes, with consequent biased siting of {MPAs}. Networks thus created frequently possess relatively low value for biodiversity conservation, despite significant costs in establishment and maintenance.
* 2.Such biases can be minimized through application of the data-driven and species-based concept of key biodiversity areas ({KBAs}).
* 3.By mapping locations of threatened species and populations that are highly aggregated in time or space, the {KBA} process allows marine sites of global biodiversity significance to be systematically identified as priority conservation targets. Here, the value of {KBAs} for marine conservation planning is outlined, and guidelines and provisional criteria for their application provided. Copyright © 2008 John Wiley \& Sons, Ltd.},
	pages = {969--983},
	number = {6},
	journaltitle = {Aquatic Conservation: Marine and Freshwater Ecosystems},
	shortjournal = {Aquatic Conserv: Mar. Freshw. Ecosyst.},
	author = {Edgar, Graham J. and Langhammer, Penny F. and Allen, Gerry and Brooks, Thomas M. and Brodie, Juliet and Crosse, William and De Silva, Naamal and Fishpool, Lincoln D. C. and Foster, Matthew N. and Knox, David H. and Mccosker, John E. and Mcmanus, Roger and Millar, Alan J. K. and Mugo, Robinson},
	urldate = {2018-03-13},
	date = {2008-09-01},
	langid = {english},
	keywords = {Biodiversity/{ES}/{NatCap}},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/UXK35ZXM/Edgar et al. - 2008 - Key biodiversity areas as globally significant tar.pdf:application/pdf},
}

@article{abramic_inspire:_nodate,
	title = {{INSPIRE}: Support for and requirement of the Marine Strategy Framework Directive},
	issn = {0308-597X},
	url = {https://www.sciencedirect.com/science/article/pii/S0308597X17303123},
	doi = {10.1016/j.marpol.2018.02.020},
	shorttitle = {{INSPIRE}},
	abstract = {This paper documents how to apply {INSPIRE} Directive 2007/2/{EC} principles for efficient implementation of the Marine Strategy Framework Directive 2008/56/{EC} ({MSFD}). It provides an overview of the different {INSPIRE} components, explains the relationship between the {MSFD} requirements and improves the understanding of distributed data management. The {MSFD} reporting cycle is analyzed in detail, identifying spatial data requirements and mapping them into the {INSPIRE} implementation roadmap. The study comprises a thorough analysis on {MSFD} requirements of data \&amp; information sharing from the initial assessment and monitoring programmes, applying {INSPIRE} data management.},
	journaltitle = {Marine Policy},
	shortjournal = {Marine Policy},
	author = {Abramic, Andrej and Gonzalez, Daniel and Bigagli, Emanuele and Che-Bohnenstengel, Anne and Smits, Paul},
