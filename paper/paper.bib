	author = {Díaz, Sandra and Pascual, Unai and Stenseke, Marie and Martín-López, Berta and Watson, Robert T. and Molnár, Zsolt and Hill, Rosemary and Chan, Kai M. A. and Baste, Ivar A. and Brauman, Kate A. and Polasky, Stephen and Church, Andrew and Lonsdale, Mark and Larigauderie, Anne and Leadley, Paul W. and Oudenhoven, Alexander P. E. van and Plaat, Felice van der and Schröter, Matthias and Lavorel, Sandra and Aumeeruddy-Thomas, Yildiz and Bukvareva, Elena and Davies, Kirsten and Demissew, Sebsebe and Erpul, Gunay and Failler, Pierre and Guerra, Carlos A. and Hewitt, Chad L. and Keune, Hans and Lindley, Sarah and Shirayama, Yoshihisa},
