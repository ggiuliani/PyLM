	note = {Conference Name: {ISPRS} {TC} {III} Mid-term Symposium “Beyond the canopy: technologies and applications of remote sensing” - 4–8 November 2024, Belém, Brazil
Publisher: Copernicus {GmbH}},
	keywords = {Earth Observations, {AI}},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/SL9ZNR3Q/Abdulmuttalib et al. - 2024 - Remote Sensing Data Quality in the Era of AI.pdf:application/pdf},
}

@incollection{orr_chapter_2024,
	title = {Chapter 3 - Land degradation and drought in mountains},
	isbn = {978-0-12-822095-5},
	url = {https://www.sciencedirect.com/science/article/pii/B9780128220955000036},
	abstract = {Global mountains are characterized by their iconic landscapes, diversity of nature, and unique economies and cultures. Mountain social-ecological systems face the threat of environmental, economic, and societal change, which are more pronounced in high elevation montane systems due to the extreme topography and climate, high level of past and/or current exploitation, and acute sensitivity to climate change. These threats are manifest in the loss of productivity and complexity of mountain lands, known as land degradation. The interactions between land degradation and climate change are exacerbated in mountain regions by the effects of more frequent and severe droughts. Here we characterize mountain social-ecological systems in the context of environmental and social change and the associated impacts of land degradation and drought. We then introduce land degradation neutrality ({LDN}), the resilience-based framework which aims to keep land in balance by helping land planners, natural resource managers working to keep food, water, climate, and nature in balance as well.},
	pages = {17--22},
	booktitle = {Safeguarding Mountain Social-Ecological Systems},
