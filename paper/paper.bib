	file = {PDF:/Users/gregorygiuliani/Zotero/storage/MZ8JI4VV/Ghassemi et al. - 2024 - European Union crop map 2022 Earth observation’s 10-meter dive into Europe’s crop tapestry.pdf:application/pdf},
