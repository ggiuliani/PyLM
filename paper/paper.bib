	langid = {english},
	keywords = {Geoprocessing},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/T7XX5TH3/Olasz et al. - 2016 - Development of a new framework for Distributed Pro.pdf:application/pdf},
}

@online{sucameli_soluzioni_2015,
