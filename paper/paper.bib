	langid = {english},
	keywords = {Geology, Earth Observations},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/AYHT2JCJ/Raspini et al. - 2018 - Continuous, semi-automatic monitoring of ground de.pdf:application/pdf},
