@misc{osorno-covarrubias_cartographic_2024,
	title = {Cartographic Journals in the Era of Artificial Intelligence: Terra Digitalis and the Emergence of Peer-Reviewed {FAIR} Geospatial Data},
	url = {https://www.preprints.org/manuscript/202401.2139/v1},
	doi = {10.20944/preprints202401.2139.v1},
	shorttitle = {Cartographic Journals in the Era of Artificial Intelligence},
	abstract = {The ongoing expansion in volume, velocity and variety of geospatial data has stimulated the development of artificial intelligence applications and associated online cartographic visualizations. In this context, the cartographic communication through peer-reviewed media evolved to incorporate Findability, Accessibility, Interoperability and Re-usability ({FAIR}) principles. In this paper, we review the functionalities proposed by current international peer-reviewed media for accessing, exploring and re-using geospatial data, and situate them on a diagram conceived for peer-reviewed cartography in the artificial intelligence era. We then present an overview of the cartographic infrastructure and workflow currently available in the Terra Digitalis journal for the online publication of massive spatiotemporal data. This free and opensource based solution allows a smooth integration, from data submission to final peer reviewed publication, of dynamic, interactive 2D and 3D maps. As a proof of concept, we present two maps derived from massive spatiotemporal data, related, respectively, to a climate numerical model (raster data) and a bike sharing system’s origin-destination dataset (vector data). We argue that the combination of technologies used in the journal provides an efficient and low-cost solution, unmatched by other publication media, to boost the accessibility and {FAIR} principles for geospatial big data.},
	number = {2024012139},
	publisher = {Preprints},
	author = {Osorno-Covarrubias, Francisco Javier and Couturier, Stéphane and Martínez-Zazueta, Iván and López-Quiroz, Penélope and Ferrari, Luca and Lastra, Manuel Suárez},
	urldate = {2024-10-13},
	date = {2024-01-31},
	langid = {english},
	keywords = {Geology, {SDI}, Cartography, {AI}},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/BRBGAF56/Osorno-Covarrubias et al. - 2024 - Cartographic Journals in the Era of Artificial Intelligence Terra Digitalis and the Emergence of Pe.pdf:application/pdf},
}

@article{noardo_standards_2024,
	title = {Standards for Data Space Building Blocks},
