	langid = {english},
	note = {Number: 3
Publisher: Multidisciplinary Digital Publishing Institute},
	keywords = {Earth Observations, Vegetation},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/M947Y5A2/Pacheco-Pascagaza et al. - 2022 - Near Real-Time Change Detection System Using Senti.pdf:application/pdf;Snapshot:/Users/gregorygiuliani/Zotero/storage/T7P6FB8N/707.html:text/html},
