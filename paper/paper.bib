	keywords = {Land Cover/Land Use},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/UASRWFP7/Myers et al. - 2023 - Seasonal variation in landcover estimates reveals .pdf:application/pdf},
}

