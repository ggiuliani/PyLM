	keywords = {Earth Observations, Biodiversity/{ES}/{NatCap}},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/LX9M2DLM/Senf - 2022 - Seeing the System from Above The Use and Potentia.pdf:application/pdf},
}

@article{kepka_advanced_2022,
	title = {An Advanced Open Land Use Database as a Resource to Address Destination Earth Challenges},
	volume = {11},
	rights = {http://creativecommons.org/licenses/by/3.0/},
