	title = {{MONITORING} {URBAN} {HEAT} {ISLAND} {THROUGH} {GOOGLE} {EARTH} {ENGINE}: {POTENTIALITIES} {AND} {DIFFICULTIES} {IN} {DIFFERENT} {CITIES} {OF} {THE} {UNITED} {STATES}},
