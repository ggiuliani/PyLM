@article{demuzere_mapping_2019,
	title = {Mapping Europe into local climate zones},
	volume = {14},
	issn = {1932-6203},
	url = {https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0214474},
	doi = {10.1371/journal.pone.0214474},
	abstract = {Cities are major drivers of environmental change at all scales and are especially at risk from the ensuing effects, which include poor air quality, flooding and heat waves. Typically, these issues are studied on a city-by-city basis owing to the spatial complexity of built landscapes, local topography and emission patterns. However, to ensure knowledge sharing and to integrate local-scale processes with regional and global scale modelling initiatives, there is a pressing need for a world-wide database on cities that is suited for environmental studies. In this paper we present a European database that has a particular focus on characterising urbanised landscapes. It has been derived using tools and techniques developed as part of the World Urban Database and Access Portal Tools ({WUDAPT}) project, which has the goal of acquiring and disseminating climate-relevant information on cities worldwide. The European map is the first major step toward creating a global database on cities that can be integrated with existing topographic and natural land-cover databases to support modelling initiatives.},
	pages = {e0214474},
	number = {4},
	journaltitle = {{PLOS} {ONE}},
	shortjournal = {{PLOS} {ONE}},
	author = {Demuzere, Matthias and Bechtel, Benjamin and Middel, Ariane and Mills, Gerald},
	urldate = {2021-02-15},
	date = {2019-04-24},
	langid = {english},
	note = {Publisher: Public Library of Science},
	keywords = {Climate, urban, lcz},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/MIMIYM3I/Demuzere et al. - 2019 - Mapping Europe into local climate zones.pdf:application/pdf},
}

@article{small_wide-area_2021,
	title = {Wide-Area Analysis-Ready Radar Backscatter Composites},
	issn = {1558-0644},
	doi = {10.1109/TGRS.2021.3055562},
	abstract = {The benefits of composite products are well known to users of data from optical sensors: cloud-cleared composite reflectance or index products are commonly used as an analysis-ready data ({ARD}) layer. No analogous composite products are currently in widespread use that is based on spaceborne radar satellite backscatter signals. Here, we present a methodology to produce wide-area {ARD} composite backscatter images. They build on the existing heritage of geometrically and radiometrically terrain corrected level 1 products. By combining backscatter measurements of a single region seen from multiple satellite tracks (incl. ascending and descending), they are able to provide wide-area coverage with low latency. The analysis-ready composite backscatter maps provide flattened backscatter estimates that are geometrically and radiometrically corrected for slope effects. A mask layer annotating the local quality of the composite resolution is introduced. Multiple tracks are combined by weighting each observation by its local resolution, generating seamless wide-area backscatter maps suitable for applications ranging from wet snow monitoring to land cover classification or short-term change detection.},
	pages = {1--14},
	journaltitle = {{IEEE} Transactions on Geoscience and Remote Sensing},
	author = {Small, D. and Rohner, C. and Miranda, N. and Rüetschi, M. and Schaepman, M. E.},
	date = {2021},
	note = {Conference Name: {IEEE} Transactions on Geoscience and Remote Sensing},
	keywords = {Earth Observations},
	file = {IEEE Xplore Full Text PDF:/Users/gregorygiuliani/Zotero/storage/HTKC2HKX/Small et al. - 2021 - Wide-Area Analysis-Ready Radar Backscatter Composi.pdf:application/pdf;Small et al. - 2021 - Wide-Area Analysis-Ready Radar Backscatter Composi.pdf:/Users/gregorygiuliani/Zotero/storage/QH5HHELQ/Small et al. - 2021 - Wide-Area Analysis-Ready Radar Backscatter Composi.pdf:application/pdf},
}

