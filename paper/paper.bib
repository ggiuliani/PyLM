	langid = {english},
	note = {Number: 1
Publisher: Nature Publishing Group},
	keywords = {{GG} publications},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/FQGKIZW6/Külling et al. - 2024 - SWECO25 a cross-thematic raster database for ecol.pdf:application/pdf},
