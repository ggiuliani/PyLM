	urldate = {2019-08-13},
	date = {2016},
	langid = {english},
	doi = {10.1007/978-3-319-21569-3_3},
	keywords = {Big Data},
	file = {Springer Full Text PDF:/Users/gregorygiuliani/Zotero/storage/YHZW99HN/Curry - 2016 - The Big Data Value Chain Definitions, Concepts, a.pdf:application/pdf},
}

