	date = {2020},
	langid = {english},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/sd.2102},
	keywords = {Sustainability/{SDG}/{PB}},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/57IY29N8/Lyytimäki et al. - Risks of producing and using indicators of sustain.pdf:application/pdf},
}

@article{aguilar_cloud_2020,
