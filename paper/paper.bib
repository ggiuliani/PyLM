	isbn = {978-1-119-45712-1},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781119457121.ch6},
	shorttitle = {Ecosystemic Services Assessment},
	abstract = {This chapter describes the functioning of forest ecosystems for the protection of water resources within water catchment perimeters ({PPE}) in Tropical Islands. The function state assessment is estimated by assessing the loss of services related to forest degradation. The method is divided into five main steps detailed as {PPE} database preparation, erosion hazard determination for each {PPE}, dominant vegetation type determination for each {PPE}, forest fragmentation estimates for each {PPE}, and forest function assessment for each {PPE}. The estimates of the percentage of each erosion hazard class in each {PPE} polygon is carried out by zonal statistics between the binary masks and the {PPE} vector layer. Forest function state for water resource protection consists of concatenating the three parameters: erosion hazard, dominant vegetation and forest fragmentation.},
