	keywords = {Earth Observations, Essential Variables, Biodiversity/{ES}/{NatCap}},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/VBK4ZEYF/Griffith et al. - 2024 - BON in a Box An Open and Collaborative Platform for Biodiversity Monitoring, Indicator Calculation,.pdf:application/pdf},
