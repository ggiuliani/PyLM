	file = {Mondejar et al. - 2021 - Digitalization to achieve sustainable development .pdf:/Users/gregorygiuliani/Zotero/storage/9H7KY7G5/Mondejar et al. - 2021 - Digitalization to achieve sustainable development .pdf:application/pdf},
