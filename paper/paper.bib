@article{pohankova_estimating_2025,
	title = {Estimating Bowen ratio in local environment based on satellite imagery},
	volume = {17},
	rights = {De Gruyter expressly reserves the right to use all content for commercial text and data mining within the meaning of Section 44b of the German Copyright Act.},
	issn = {2391-5447},
	url = {https://www.degruyterbrill.com/document/doi/10.1515/geo-2025-0774/html},
	doi = {10.1515/geo-2025-0774},
	abstract = {This study presents a remote sensing approach to estimating the Bowen ratio ({BR}), focusing on its application across landscapes in a small-scale region of Olomouc, Czech Republic. Traditionally, {BR} has been calculated using in situ measurements, which restrict spatial coverage and scalability. Using satellite imagery, this research shows a spatially explicit approach to estimating {BR}, creating a departure from conventional techniques. The framework integrates remote sensing techniques, including atmospheric corrections and the derivation of land surface temperature, albedo, and net radiation, to generate higher-resolution {BR} estimates. This creative approach bridges a critical gap in local-scale {BR} estimation by enabling cost-effective, repeatable, and scalable analyses across varying land cover types. The findings not only highlight the spatial variability of {BR} but also demonstrate the transformative potential of remote sensing in advancing our understanding of land–atmosphere interactions. This pioneering method opens new pathways for sustainable management of water and energy resources while offering fresh insights into regional energy fluxes and hydrological processes.},
	number = {1},
	journaltitle = {Open Geosciences},
	author = {Pohanková, Tereza and Pechanec, Vilém},
	urldate = {2025-06-13},
	date = {2025-01-01},
	langid = {english},
	keywords = {Earth Observations, urban},
	file = {10.1515_geo-2025-0774:/Users/gregorygiuliani/Zotero/storage/PM7T9UMC/10.1515_geo-2025-0774.pdf:application/pdf},
}

@article{braham_spectralearth_2025,
	title = {{SpectralEarth}: Training Hyperspectral Foundation Models at Scale},
	issn = {2151-1535},
	url = {https://ieeexplore.ieee.org/document/11045062},
	doi = {10.1109/JSTARS.2025.3581451},
	shorttitle = {{SpectralEarth}},
	abstract = {Foundation models have triggered a paradigm shift in computer vision and are increasingly being adopted in remote sensing, particularly for multispectral imagery. Yet, their potential in hyperspectral imaging ({HSI}) remains untapped due to the absence of comprehensive and globally representative hyperspectral datasets. To close this gap, we introduce {SpectralEarth}, a large-scale multi-temporal dataset designed to pretrain hyperspectral foundation models leveraging data from the Environmental Mapping and Analysis Program ({EnMAP}). {SpectralEarth} comprises 538,974 image patches covering 415,153 unique locations from 11,636 globally distributed {EnMAP} scenes spanning two years of archive. Additionally, 17.5\% of these locations include multiple timestamps, enabling multi-temporal {HSI} analysis. Utilizing state-of-the-art self-supervised learning ({SSL}) algorithms, we pretrain a series of foundation models on {SpectralEarth}, integrating a spectral adapter into classical vision backbones to accommodate the unique characteristics of {HSI}. In tandem, we construct nine downstream datasets for land-cover, crop-type mapping, and tree-species classification, providing benchmarks for model evaluation. Experimental results support the versatility of our models and their generalizability across different tasks and sensors. We also highlight computational efficiency during model fine-tuning. The dataset, pretrained models, and code are publicly available.},
	pages = {1--19},
	journaltitle = {{IEEE} Journal of Selected Topics in Applied Earth Observations and Remote Sensing},
	author = {Braham, Nassim Ait Ali and Albrecht, Conrad M. and Mairal, Julien and Chanussot, Jocelyn and Wang, Yi and Zhu, Xiao Xiang},
	urldate = {2025-06-23},
	date = {2025},
	keywords = {Earth Observations, {AI}},
	file = {PDF:/Users/gregorygiuliani/Zotero/storage/K2QX3HRB/Braham et al. - 2025 - SpectralEarth Training Hyperspectral Foundation Models at Scale.pdf:application/pdf},
}

