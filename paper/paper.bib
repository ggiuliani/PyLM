	langid = {english},
	note = {Number: 19
Publisher: Multidisciplinary Digital Publishing Institute},
	keywords = {Water/Hydrology/Oceans, Earth Observations},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/U8XCZ8NA/Lefebvre et al. - 2019 - Introducing WIW for Detecting the Presence of Wate.pdf:application/pdf},
