	keywords = {Land Cover/Land Use, Land Degradation},
	file = {ScienceDirect Full Text PDF:/Users/gregorygiuliani/Zotero/storage/M5X96FGQ/Verburg et al. - 2015 - Land system science and sustainable development of.pdf:application/pdf},
