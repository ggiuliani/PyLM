	date = {2015-11-17},
	keywords = {Sensors},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/KM52FB78/Cannata et al. - 2015 - istSOS, a new sensor observation management system.pdf:application/pdf},
}

