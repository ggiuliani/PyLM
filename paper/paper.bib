	keywords = {Earth Observations},
	file = {IOP Full Text PDF:/Users/gregorygiuliani/Zotero/storage/SJ5VXLQJ/Jin and Dickinson - 2010 - Land surface skin temperature climatology benefit.pdf:application/pdf},
}

