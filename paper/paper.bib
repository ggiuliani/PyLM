@article{albert_winners_2017,
	title = {Winners and losers as mangrove, coral and seagrass ecosystems respond to sea-level rise in Solomon Islands},
	volume = {12},
	issn = {1748-9326},
	url = {http://stacks.iop.org/1748-9326/12/i=9/a=094009},
	doi = {10.1088/1748-9326/aa7e68},
	abstract = {A 2007 earthquake in the western Solomon Islands resulted in a localised subsidence event in which sea level (relative to the previous coastal settings) rose approximately 30–70 cm, providing insight into impacts of future rapid changes to sea level on coastal ecosystems. Here, we show that increasing sea level by 30–70 cm can have contrasting impacts on mangrove, seagrass and coral reef ecosystems. Coral reef habitats were the clear winners with a steady lateral growth from 2006–2014, yielding a 157\% increase in areal coverage over seven years. Mangrove ecosystems, on the other hand, suffered the largest impact through a rapid dieback of 35\% (130 ha) of mangrove forest in the study area after subsidence. These forests, however, had partially recovered seven years after the earthquake albeit with a different community structure. The shallow seagrass ecosystems demonstrated the most dynamic response to relative shifts in sea level with both losses and gains in areal extent at small scales of 10–100 m. The results of this study emphasize the importance of considering the impacts of sea-level rise within a complex landscape in which winners and losers may vary over time and space.},
	pages = {094009},
	number = {9},
	journaltitle = {Environmental Research Letters},
	shortjournal = {Environ. Res. Lett.},
	author = {Albert, Simon and Saunders, Megan I. and Roelfsema, Chris M. and Leon, Javier X. and Johnstone, Elizabeth and Mackenzie, Jock R. and Hoegh-Guldberg, Ove and Grinham, Alistair R. and Phinn, Stuart R. and Duke, Norman C. and Mumby, Peter J. and {Eva Kovacs} and Woodroffe, Colin D.},
	urldate = {2017-09-13},
	date = {2017},
	langid = {english},
	keywords = {Biodiversity/{ES}/{NatCap}},
	file = {IOP Full Text PDF:/Users/gregorygiuliani/Zotero/storage/TIEXLJFT/Albert et al. - 2017 - Winners and losers as mangrove, coral and seagrass.pdf:application/pdf},
}

@article{andrew_spatial_2015,
	title = {Spatial data, analysis approaches, and information needs for spatial ecosystem service assessments: a review},
	volume = {52},
	issn = {1548-1603},
	url = {http://dx.doi.org/10.1080/15481603.2015.1033809},
	doi = {10.1080/15481603.2015.1033809},
	shorttitle = {Spatial data, analysis approaches, and information needs for spatial ecosystem service assessments},
	abstract = {Operational use of the ecosystem service ({ES}) concept in conservation and planning requires quantitative assessments based on accurate mapping of {ESs}. Our goal is to review spatial assessments of {ESs}, with an emphasis on the socioecological drivers of {ESs}, the spatial datasets commonly used to represent those drivers, and the methodological approaches used to spatially model {ESs}. We conclude that diverse strategies, integrating both spatial and aspatial data, have been used to map {ES} supply and human demand. Model parameters representing abiotic ecosystem properties can be supported by use of well-developed and widely available spatial datasets. Land-cover data, often manipulated or subject to modeling in a {GIS}, is the most common input for {ES} modeling; however, assessments are increasingly informed by a mechanistic understanding of the relationships between drivers and services. We suggest that {ES} assessments are potentially weakened by the simplifying assumptions often needed to translate between conceptual models and widely used spatial data. Adoption of quantitative spatial data that more directly represent ecosystem properties may improve parameterization of mechanistic {ES} models and increase confidence in {ES} assessments.},
	pages = {344--373},
	number = {3},
	journaltitle = {{GIScience} \& Remote Sensing},
	author = {Andrew, Margaret E. and Wulder, Michael A. and Nelson, Trisalyn A. and Coops, Nicholas C.},
	urldate = {2017-09-13},
	date = {2015-05-04},
	keywords = {Biodiversity/{ES}/{NatCap}},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/B37ARSSF/Andrew et al. - 2015 - Spatial data, analysis approaches, and information.pdf:application/pdf;Full Text PDF:/Users/gregorygiuliani/Zotero/storage/FQLF7NNL/Andrew et al. - 2015 - Spatial data, analysis approaches, and information.pdf:application/pdf;Full Text PDF:/Users/gregorygiuliani/Zotero/storage/9BJLI6G9/Andrew et al. - 2015 - Spatial data, analysis approaches, and information.pdf:application/pdf},
