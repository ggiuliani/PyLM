	date = {2024-11-13},
	note = {Publisher: Royal Society},
	keywords = {{ICT}},
	file = {PDF:/Users/gregorygiuliani/Zotero/storage/N2FA6LL8/Maillart et al. - 2024 - Computational diplomacy how ‘hackathons for good’ feed a participatory future for multilateralism i.pdf:application/pdf},
