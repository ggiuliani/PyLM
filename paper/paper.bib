@article{abrahamyan_no2_2023,
	title = {{NO}2 Data Analytics and Visualization Service: Improving Air Quality Insights in Armenia and Belarus},
	volume = {49},
	issn = {1608-3261},
	url = {https://doi.org/10.1134/S0361768823090025},
	doi = {10.1134/S0361768823090025},
	shorttitle = {{NO}2 Data Analytics and Visualization Service},
	abstract = {Over time, the population and anthropogenic activities increase, adversely affecting our atmosphere. In particular, an increase in air temperature leads to a change in the number of various gases that fill the atmosphere, the growth and decrease of which can significantly affect the environment. Nitrogen dioxide ({NO}2) is a common air pollutant from natural and human activities, with potential respiratory irritant effects at high levels. To effectively address these issues, there is a need for advanced tools and services that can analyze and visualize {NO}2 air pollution data comprehensively. This article presents the development and implementation of a Data Analytics and Visualization Service tailored to Armenia and Belarus’s unique air quality dynamics. The service aims to provide actionable insights for policymakers, researchers, and the public. The studies show that {NO}2 excesses in their troposphere for Armenia and Belarus. This increase is correlated with the rise in urban population, causing dramatic adverse effects on the atmosphere.},
