	keywords = {{OGC}/Standards/Interoperability, {INSPIRE}},
	file = {Springer Full Text PDF:/Users/gregorygiuliani/Zotero/storage/WG397T8J/Baumann and Escriu - 2019 - INSPIRE coverages an analysis and some suggestion.pdf:application/pdf},
}

