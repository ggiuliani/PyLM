	note = {Number: 15
Publisher: Multidisciplinary Digital Publishing Institute},
	keywords = {Earth Observations, {AI}},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/JWHE79YA/Cilli et al. - 2020 - Machine Learning for Cloud Detection of Globally D.pdf:application/pdf},
}

