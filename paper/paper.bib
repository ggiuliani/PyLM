@article{granell_interlinking_2010,
	title = {Interlinking Geoprocessing Services},
	url = {://WOS:000278203000017},
	doi = {10.1109/GEOProcessing.2010.22},
	shorttitle = {Interlinking Geoprocessing Services},
	abstract = {Rapid discovery and access of geospatial resources is critical for many application domains that require agile data integration. In this context, cross-domain geospatial applications need immediate access to geospatial resources of interest in order to rapidly integrate them in scalable, functional Web applications. In this paper we explore new perspectives to build pragmatic geospatial Web applications, drawing on the ideas of recent initiatives like Linked Open Data ({LOD}) and Open Archives Initiative ({OAI}). By using {OAI}'s standards along with {LOD} principles we are able to model single and composite geoprocessing services as a collection of heterogeneous Web resources. Such collections are built by the principle aggregation by linking that enables to connect and link multiple geospatial data and services across different application domains.},
