	langid = {english},
	note = {Number: 1
Publisher: Multidisciplinary Digital Publishing Institute},
	keywords = {Land Degradation},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/YNTX4SJT/Manna et al. - 2024 - A Geospatial Decision Support System for Supportin.pdf:application/pdf},
