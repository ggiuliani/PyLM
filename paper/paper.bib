	shortjournal = {{PNAS}},
	author = {Schrodt, Franziska and Bailey, Joseph J. and Kissling, W. Daniel and Rijsdijk, Kenneth F. and Seijmonsbergen, Arie C. and Ree, Derk van and Hjort, Jan and Lawley, Russell S. and Williams, Christopher N. and Anderson, Mark G. and Beier, Paul and Beukering, Pieter van and Boyd, Doreen S. and Brilha, José and Carcavilla, Luis and Dahlin, Kyla M. and Gill, Joel C. and Gordon, John E. and Gray, Murray and Grundy, Mike and Hunter, Malcolm L. and Lawler, Joshua J. and Monge-Ganuzas, Manu and Royse, Katherine R. and Stewart, Iain and Record, Sydne and Turner, Woody and Zarnetske, Phoebe L. and Field, Richard},
