}

@article{gomes_brazil_2024,
	title = {Brazil Data Cube Workflow Engine: a tool for big Earth observation data processing},
	volume = {17},
	issn = {1753-8947},
	url = {https://doi.org/10.1080/17538947.2024.2313099},
