	keywords = {Earth Observations},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/X4HTTWIN/Alexandris et al. - 2017 - Remote sensing of burned areas via PCA, Part 1\; ce.pdf:application/pdf},
}

