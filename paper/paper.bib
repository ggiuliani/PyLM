	langid = {english},
	note = {Publisher: Hindawi},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/QK5AIY69/Ukhurebor et al. - 2024 - Environmental Influence of Gas Flaring Perspectiv.pdf:application/pdf},
