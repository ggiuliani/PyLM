@article{karpouzoglou_environmental_2016,
	title = {Environmental Virtual Observatories ({EVOs}): prospects for knowledge co-creation and resilience in the Information Age},
	volume = {18},
	issn = {1877-3435},
	url = {http://www.sciencedirect.com/science/article/pii/S1877343515000792 http://ac.els-cdn.com/S1877343515000792/1-s2.0-S1877343515000792-main.pdf?_tid=1e9e9408-7bcb-11e5-938d-00000aacb35d&acdnat=1445854982_f43dcb6250772feef7d8402e379180c6},
	doi = {10.1016/j.cosust.2015.07.015},
	shorttitle = {Environmental Virtual Observatories ({EVOs}): prospects for knowledge co-creation and resilience in the Information Age},
	abstract = {Developments in technologies are shaping information access globally. This presents opportunities and challenges for understanding the role of new technologies in sustainability research. This article focuses on a suite of technologies termed Environmental Virtual Observatories ({EVOs}) developed for communicating observations and simulation of environmental processes. A strength of {EVOs} is that they are open and decentralised, thus democratising flow and ownership of information between multiple actors. However, {EVOs} are discussed rarely beyond their technical aspects. By evaluating the evolution of {EVOs}, we illustrate why it is timely to engage with policy and societal aspects as well. While first generation {EVOs} are primed for scientists, second generation {EVOs} can have broader implications for knowledge co-creation and resilience through their participatory design.},
	pages = {40--48},
	journaltitle = {Current Opinion in Environmental Sustainability},
	author = {Karpouzoglou, Timothy and Zulkafli, Zed and Grainger, Sam and Dewulf, Art and Buytaert, Wouter and Hannah, David M.},
	date = {2016},
	keywords = {{SDI}},
	file = {1-s2.0-S1877343515000792-main:/Users/gregorygiuliani/Zotero/storage/89PR9GJE/1-s2.0-S1877343515000792-main.pdf:application/pdf},
}

