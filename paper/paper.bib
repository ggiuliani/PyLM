	author = {Ferreira, Karine R. and Queiroz, Gilberto R. and Vinhas, Lubia and Marujo, Rennan F. B. and Simoes, Rolf E. O. and Picoli, Michelle C. A. and Camara, Gilberto and Cartaxo, Ricardo and Gomes, Vitor C. F. and Santos, Lorena A. and Sanchez, Alber H. and Arcanjo, Jeferson S. and Fronza, José Guilherme and Noronha, Carlos Alberto and Costa, Raphael W. and Zaglia, Matheus C. and Zioti, Fabiana and Korting, Thales S. and Soares, Anderson R. and Chaves, Michel E. D. and Fonseca, Leila M. G.},
	urldate = {2020-12-09},
	date = {2020-01},
	langid = {english},
	note = {Number: 24
Publisher: Multidisciplinary Digital Publishing Institute},
	keywords = {Earth Observations, Data Cube, Land Cover/Land Use},
