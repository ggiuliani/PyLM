	urldate = {2024-06-19},
	date = {2023-10-01},
	pmid = {37208222},
	note = {Publisher: Elsevier},
	keywords = {Geoprocessing, Environment, digital earth, Biodiversity/{ES}/{NatCap}, Digital Twin},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/MA7NYIDE/Koning et al. - 2023 - Digital twins dynamic model-data fusion for ecolo.pdf:application/pdf},
}

