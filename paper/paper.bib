@article{tondapu_servir_2018,
	title = {A {SERVIR} {FAO} Open Source Partnership: Co-development of Open Source Web Technologies using Earth Observation for Land Cover Mapping.},
	volume = {21},
	url = {http://adsabs.harvard.edu/abs/2018AGUFMIN21B..27T},
	shorttitle = {A {SERVIR} {FAO} Open Source Partnership},
	abstract = {In 2015, {SERVIR}-Mekong conducted a geospatial needs assessment for the 
Lower Mekong countries. During this assessment, regional stakeholders
identified a need for a regional land cover monitoring system ({RLCMS})
that will produce frequent, high-quality land cover maps using a
consistent regional classification scheme and open resources that are
compatible with country needs at the national level. Though the {RLCMS}
was developed for the Lower Mekong countries, the system has been
modified for use in nearly any region and time period with Landsat
satellite coverage, so long as there is sufficient reference data
collected. This open source system was developed in Google Earth Engine,
a cloud-based computing environment with access to the full archive of
Landsat imagery. It will help in planning and decision making for many
users. This system is dependent on a method to collect reference data
and a system to document workflows for replication in an operational
setting.

As a result, the {SERVIR} team reached out to the United Nations Food and
Agriculture Organization ({FAO}) to synchronize development efforts and
integrate tools. The first integration effort was the co-development of
Collect Earth Online ({CEO}), a reference data collection system that
builds on {FAO}'s existing Collect Earth framework. {CEO} promotes
consistency in locating, interpreting, and labeling reference data plots
for use in classifying and monitoring land cover/land use change. The
full functionality of {CEO} including the collaborative compilation of an
online reference point databases, so there is no need for desktop
installation in hardware limited environments.

The second integration focused on documenting the {RLCMS} workflow within
{FAO}'s {SEPAL}. {SEPAL} is a project of the Forestry Department of the ({FAO})
funded by the Government of Norway. {SEPAL} is a cloud computing-based
platform for autonomous land monitoring using remotely sensed data. It
is a combination of Google Earth Engine and open source software {ORFEO}
Toolbox, {GDAL}, R, R Studio Server, R Shiny Server, {SNAP} Toolkit, and
{OpenForis} Geospatial Toolkit. It allows users to access powerful
cloud-computing resources to query access and process satellite data
quickly and efficiently for creating advanced analyses. Integrating
{RLCMS} to {SEPAL} would make it available as one of the open source
software tools that are available in {SEPAL}.},
	journaltitle = {{AGU} Fall Meeting Abstracts},
	shortjournal = {{AGU} Fall Meeting Abstracts},
	author = {Tondapu, G. and Markert, K. and Lindquist, E. J. and Wiell, D. and Díaz, A. S. P. and Johnson, G. and Ashmall, W. and Chishtie, F. and Ate, P. and Tenneson, K. and Patterson, M. S. and Ricci, S. and Fontanarosa, R. and Saah, D.},
	urldate = {2020-09-29},
	date = {2018-12-01},
	keywords = {Earth Observations},
}

@article{brovelli_monitoring_2020,
	title = {Monitoring Forest Change in the Amazon Using Multi-Temporal Remote Sensing Data and Machine Learning Classification on Google Earth Engine},
	volume = {9},
	rights = {http://creativecommons.org/licenses/by/3.0/},
	url = {https://www.mdpi.com/2220-9964/9/10/580},
	doi = {10.3390/ijgi9100580},
	abstract = {Deforestation causes diverse and profound consequences for the environment and species. Direct or indirect effects can be related to climate change, biodiversity loss, soil erosion, floods, landslides, etc. As such a significant process, timely and continuous monitoring of forest dynamics is important, to constantly follow existing policies and develop new mitigation measures. The present work had the aim of mapping and monitoring the forest change from 2000 to 2019 and of simulating the future forest development of a rainforest region located in the Par\&aacute; state, Brazil. The land cover dynamics were mapped at five-year intervals based on a supervised classification model deployed on the cloud processing platform Google Earth Engine. Besides the benefits of reduced computational time, the service is coupled with a vast data catalogue providing useful access to global products, such as multispectral images of the missions Landsat five, seven, eight and Sentinel-2. The validation procedures were done through photointerpretation of high-resolution panchromatic images obtained from {CBERS} (China\&ndash;Brazil Earth Resources Satellite). The more than satisfactory results allowed an estimation of peak deforestation rates for the period 2000\&ndash;2006; for the period 2006\&ndash;2015, a significant decrease and stabilization, followed by a slight increase till 2019. Based on the derived trends a forest dynamics was simulated for the period 2019\&ndash;2028, estimating a decrease in the deforestation rate. These results demonstrate that such a fusion of satellite observations, machine learning, and cloud processing, benefits the analysis of the forest dynamics and can provide useful information for the development of forest policies.},
	pages = {580},
	number = {10},
	journaltitle = {{ISPRS} International Journal of Geo-Information},
	author = {Brovelli, Maria Antonia and Sun, Yaru and Yordanov, Vasil},
	urldate = {2020-10-01},
	date = {2020-10},
	langid = {english},
	note = {Number: 10
Publisher: Multidisciplinary Digital Publishing Institute},
	keywords = {Earth Observations, Land Cover/Land Use, {AI}, Vegetation},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/BP7VWVGU/Brovelli et al. - 2020 - Monitoring Forest Change in the Amazon Using Multi.pdf:application/pdf},
}

