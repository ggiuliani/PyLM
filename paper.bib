@article{etherington_nlmpy_2015,
	title = {{NLMpy}: a python software package for the creation of neutral landscape models within a general numerical framework},
	volume = {6},
	rights = {© 2014 The Authors. Methods in Ecology and Evolution © 2014 British Ecological Society},
	issn = {2041-210X},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/2041-210X.12308},
	doi = {10.1111/2041-210X.12308},
	shorttitle = {{NLMpy}},
	abstract = {Neutral landscape models ({NLMs}) are widely used to model ecological patterns and processes across landscapes. However, the ability to generate {NLMs} is often made available through standalone bespoke software packages that have platform limitations. We have developed a python package that brings together some of the more popular {NLM} algorithms using a general numerical framework. The resulting {NLMpy} package: (i) allows for the creation of {NLMs} directly within a python modelling workflow or by other modelling software capable executing a python script, (ii) enables the first opportunity to create a {NLM} that combines different algorithms, (iii) provides easy integration with geographic information system data and (iv) creates a framework for developing other {NLMs}.},
	pages = {164--168},
	number = {2},
	journaltitle = {Methods in Ecology and Evolution},
	author = {Etherington, Thomas R. and Holland, E. Penelope and O'Sullivan, David},
	urldate = {2025-09-09},
	date = {2015},
	langid = {english},
	note = {\_eprint: https://besjournals.onlinelibrary.wiley.com/doi/pdf/10.1111/2041-210X.12308},
	keywords = {Landscape Mosaic},
	file = {Full Text PDF:/Users/gregorygiuliani/Zotero/storage/QYT9PR8J/Etherington et al. - 2015 - NLMpy a python software package for the creation of neutral landscape models within a general numer.pdf:application/pdf},
}

@article{bosch_pylandstats_2019,
	title = {{PyLandStats}: An open-source Pythonic library to compute landscape metrics},
	volume = {14},
	issn = {1932-6203},
	url = {https://www.ncbi.nlm.nih.gov/pmc/articles/PMC6894873/},
	doi = {10.1371/journal.pone.0225734},
	shorttitle = {{PyLandStats}},
	abstract = {Quantifying the spatial pattern of landscapes has become a common task of many studies in landscape ecology. Most of the existing software to compute landscape metrics is not well suited to be used in interactive environments such as Jupyter notebooks nor to be included as part of automated computational workflows. This article presents {PyLandStats}, an open-source Pythonic library to compute landscape metrics within the scientific Python stack. The {PyLandStats} package provides a set of methods to quantify landscape patterns, such as the analysis of the spatiotemporal patterns of land use/land cover change or zonal analysis. The implementation is based on the prevailing Python libraries for geospatial data analysis in a way that they can be forthwith integrated into complex computational workflows. Notably, the provided methods offer a large variety of options so that users can employ {PyLandStats} in the way that best supports their needs. The source code is publicly available, and is organized in a modular object-oriented structure that enhances its maintainability and extensibility.},
	pages = {e0225734},
	number = {12},
	journaltitle = {{PLoS} {ONE}},
	shortjournal = {{PLoS} One},
	author = {Bosch, Martí},
	urldate = {2025-09-09},
	date = {2019-12-05},
	pmid = {31805157},
	pmcid = {PMC6894873},
	keywords = {Landscape Mosaic},
	file = {Full Text:/Users/gregorygiuliani/Zotero/storage/WGGMKY2M/Bosch - 2019 - PyLandStats An open-source Pythonic library to compute landscape metrics.pdf:application/pdf},
}
